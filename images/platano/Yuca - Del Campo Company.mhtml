@charset "utf-8";

:root { --verde-principal: #2e7d32; --verde-secundario: #66bb6a; --verde-os=
curo: #1b5e20; --naranja: #ff9800; --gris-fondo: #f5f5f5; --blanco: #ffffff=
; --texto: #333; }

* { margin: 0px; padding: 0px; box-sizing: border-box; font-family: Arial, =
Helvetica, sans-serif; }

html { scroll-behavior: smooth; }

body { background: var(--gris-fondo); color: var(--texto); min-height: 100v=
h; display: flex; flex-direction: column; }

section { padding: 60px 10%; }

.why-us { background: white; border-radius: 22px; padding: 32px; box-shadow=
: rgba(0, 0, 0, 0.08) 0px 16px 32px; margin-top: 30px; }

.why-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 28px; a=
lign-items: center; }

.why-text p { font-size: 16px; line-height: 1.8; color: rgb(68, 68, 68); ma=
rgin-bottom: 22px; }

.why-text ul { list-style: none; padding: 0px; display: grid; gap: 12px; }

.why-text li { position: relative; padding-left: 28px; font-weight: 600; co=
lor: var(--texto); }

.why-text li::before { content: "=E2=9C=93"; position: absolute; left: 0px;=
 top: 0px; color: var(--verde-principal); }

.why-image img { width: 100%; border-radius: 22px; object-fit: cover; box-s=
hadow: rgba(0, 0, 0, 0.12) 0px 18px 36px; }

.header { background: linear-gradient(120deg, var(--verde-principal), var(-=
-verde-secundario)); color: white; padding: 18px 30px; display: flex; justi=
fy-content: space-between; align-items: center; flex-wrap: wrap; position: =
sticky; top: 0px; z-index: 1000; overflow: hidden; }

.header::before { content: ""; position: absolute; inset: 0px; background: =
radial-gradient(circle at left top, rgba(255, 255, 255, 0.15), transparent =
40%), radial-gradient(circle at right bottom, rgba(255, 255, 255, 0.12), tr=
ansparent 32%); pointer-events: none; }

.logo { display: flex; align-items: center; gap: 10px; position: relative; =
z-index: 1; }

.logo-img { width: 50px; border-radius: 50%; }

.logo-texto { display: flex; flex-direction: column; gap: 4px; }

.logo h1 { font-size: 20px; }

.logo p { font-size: 11px; opacity: 0.8; }

nav ul { display: flex; list-style: none; gap: 20px; }

nav a { text-decoration: none; color: white; font-weight: bold; position: r=
elative; }

.header-fruits { position: absolute; inset: 0px; pointer-events: none; z-in=
